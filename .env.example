# Template. Copy to .env and edit; .env is gitignored, this file is not.
#
# It holds no secrets and is not where secrets belong: the only sensitive material this project has
# is the serving half's state directory, which is a directory of private keys and never a value here.
#
# The two blocks below are read by different things. Keeping them in one file is a convenience, not
# a claim that they are interchangeable.

# ---------------------------------------------------------------------------------------------
# Read by `docker compose` itself, to fill in the ${...} placeholders in docker-compose.yml.
# These do NOT reach the processes: what the containers get is the `environment:` block there.
# ---------------------------------------------------------------------------------------------

# The address the serving half prints on startup, as NYM_ADDRESS=... on stdout. The dialling half
# cannot start without it, so bring the server up first, read it, and put it here.
SERVER_ADDRESS=

# What the serving half splices accepted streams to. The default reaches the container host, which
# is where a light-client server usually already runs; another compose service would be its name.
UPSTREAM=host.docker.internal:9067

# Host ports. All bound to loopback: the wallet-facing port is an unauthenticated door to the
# upstream, and the metrics ports are unauthenticated too.
CLIENT_HOST_PORT=9068
CLIENT_METRICS_PORT=9070
SERVER_METRICS_PORT=9069

# tracing-subscriber's filter. `info` is quiet; `debug` shows per-stream detail, including streams
# discarded by the probe.
RUST_LOG=info

# ---------------------------------------------------------------------------------------------
# Read by the binaries themselves, when running them directly rather than through compose:
#
#   set -a; . ./.env; set +a
#   lwd-mixnet-server
#
# Every one of these has a command-line flag that takes precedence. See `--help` on either binary,
# and the full table in README.md.
# ---------------------------------------------------------------------------------------------

# --- both halves ------------------------------------------------------------------------------
# Careful: these two names are shared by both binaries. Exporting LWD_MIXNET_METRICS_BIND and then
# running both halves on one machine means the second one exits at startup with "Address already in
# use", which is loud and immediate rather than subtle. Pass --metrics-bind per process instead.
#
# Unset means neither /metrics nor /health is served at all.
# LWD_MIXNET_METRICS_BIND=127.0.0.1:9069
# LWD_MIXNET_SHUTDOWN_GRACE_SECS=10

# --- lwd-mixnet-client ---------------------------------------------------------------------------
# LWD_MIXNET_SERVER=                       # required; the serving half's Nym address
# LWD_MIXNET_BIND=127.0.0.1:9068           # where the wallet connects
# LWD_MIXNET_PROBE_TIMEOUT_SECS=10
# LWD_MIXNET_PROBE_ATTEMPTS=6              # keep it a multiple of the concurrency below
# LWD_MIXNET_PROBE_CONCURRENCY=3
# LWD_MIXNET_NO_PROBE=                     # set to any value to hand over unprobed streams
# LWD_MIXNET_REPLY_SURBS=                  # unset leaves the SDK default of 10
# LWD_MIXNET_STALL_TIMEOUT_SECS=60

# --- lwd-mixnet-server ---------------------------------------------------------------------------
# LWD_MIXNET_UPSTREAM=127.0.0.1:9067
# LWD_MIXNET_STATE_DIR=                    # unset means an ephemeral identity: the address changes
#                                          # on every restart, and nobody can reach this half twice
# LWD_MIXNET_HANDSHAKE_TIMEOUT_SECS=30
# LWD_MIXNET_FIRST_REQUEST_TIMEOUT_SECS=60
# LWD_MIXNET_IDLE_TIMEOUT_SECS=600
# LWD_MIXNET_MAX_STREAMS=256               # streams held at once; the rest are dropped unread
# LWD_MIXNET_GATEWAY_WAIT_SECS=300         # give up on a gateway that never comes back, and exit
